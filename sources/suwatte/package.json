{
  "name": "@archettu/suwatte-sources",
  "version": "0.1.0",
  "private": true,
  "description": "CopyManga, Komiic and Japanese manga from MangaDex for Suwatte",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "build": "suwatte build && node scripts/check-artifacts.cjs",
    "serve": "suwatte serve",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:browse": "tsx scripts/smoke-browse.ts"
  },
  "suwatte": { "listName": "杕的自用漫画源" },
  "dependencies": { "@archettu/copymanga": "0.1.0", "@archettu/komiic": "0.1.0", "@archettu/mangadex": "0.1.0" },
  "devDependencies": {
    "@suwatte/toolchain": "1.0.0"
  }
}
