{
  "name": "@archettu/suwatte-sources",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Suwatte sources, starting with CopyManga",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "build": "suwatte build && node scripts/check-artifacts.cjs",
    "serve": "suwatte serve",
    "smoke": "tsx scripts/smoke.ts"
  },
  "suwatte": { "listName": "Archettu 的漫画源" },
  "dependencies": { "@archettu/copymanga": "0.1.0" },
  "devDependencies": {
    "@suwatte/toolchain": "1.0.0"
  }
}
